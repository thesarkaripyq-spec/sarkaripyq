node_modules
.next
out
build
dist
.env
.env.local
.env*.local
# Unlike Next's own convention (.env.test committed, .env.test.local
# gitignored), this repo's .env.test holds real credentials for whichever
# backend Phase 5 tests run against (local Supabase or a separate test
# project) - treated exactly like .env.local, never committed.
.env.test
*.tsbuildinfo
.DS_Store
npm-debug.log*

# Scraped TestRanking payloads: large, regenerable, and upstream-owned.
# Re-create with: python scripts/testranking/scrape_pyq.py --stage all --category ssc
data/testranking/
scripts/testranking/.cache/

__pycache__/
*.pyc

# One-off scratch scripts/dumps from working the import pipeline - not part
# of the app, regenerable, not meant to be tracked.
.tmp-*
.verify-*.json

# Supabase CLI's local cache (version check, etc.) - not project content.
supabase/.temp/

# Playwright's own run output - regenerated by every test run.
/test-results/
/playwright-report/
/blob-report/

# Lighthouse CI's own run output - regenerated by every run.
/.lighthouseci/

# Vitest coverage report - regenerated by every run.
/coverage/
