{
  "name": "sarkaripyq-backend",
  "version": "1.0.0",
  "description": "Backend API for SARKARIPYQ.COM - SSC Previous Year Questions Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedData.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "ssc",
    "pyq",
    "mcq",
    "exam",
    "education"
  ],
  "author": "SARKARIPYQ",
  "license": "ISC",
