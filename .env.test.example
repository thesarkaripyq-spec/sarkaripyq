# Copy to .env.test and fill in - see AUDIT.md "Phase 5: test data
# isolation" for how to get these values (either from `supabase status`
# after `supabase start`, or from a separate, dedicated Supabase project's
# dashboard). NEVER point these at the same project as .env.local -
# Phase 5's tests create/delete real users and write bookmarks/attempts.

# Same shape as .env.example, but for whichever backend Phase 5 tests
# run against - local (via the Supabase CLI + Docker) or a separate free
# Supabase project, never the production project in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

SUPABASE_SERVICE_ROLE_KEY=

# Only needed if Phase 5 applies migrations/seed via scripts/*.mjs
# against this test backend directly, rather than via the Supabase CLI.
SUPABASE_DB_URL=

# Always localhost - this is what next start actually binds to during
# e2e runs, regardless of which backend the vars above point at.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
