# ===========================================
# SARKARIPYQ Frontend Environment Variables
# ===========================================
# Copy this file to `.env` and fill in real values.
# All frontend env vars MUST start with REACT_APP_.

# Public Supabase (safe to ship to client)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key

# Public API base (the Express backend)
REACT_APP_API_URL=https://api.your-domain.com

# Google OAuth public client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Public site URL (used for canonical/og:url)
REACT_APP_SITE_URL=https://your-domain.com

# Disable console / verbose logs in production
# (set to "true" in dev to keep verbose logs)
REACT_APP_DEBUG=false
