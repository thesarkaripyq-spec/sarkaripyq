# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Amazon Associates tracking tag (e.g. "sarkaripyq-21"). Get one at
# affiliate-program.amazon.in. Leave empty and /books still works, just
# without earning commission.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by scripts/*.mjs (migrations/seed).
# Not read by the Next.js app at runtime. Find it under Supabase > Project Settings > Database.
SUPABASE_DB_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
